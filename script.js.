   FARUQ AYOMIDE OJOLOWO — FOUNDER WEBSITE
   Interaction Layer — FIXED
   ========================================================= */

document.addEventListener("DOMContentLoaded", () => {

  /* =======================================================
     01. ELEMENTS — CORRECTED SELECTORS
     ======================================================= */

  const body = document.body;

  // FIXED: Changed from .site-mark to .profile-trigger
  const profileTrigger = document.querySelector(".profile-trigger");
  
  // FIXED: Changed from .profile-orbit to .profile-social-panel
  const profilePanel = document.querySelector(".profile-social-panel");
  const profileOrbit = document.querySelector(".profile-social-orbit");

  const menuButton = document.querySelector(".mobile-menu-button");
  const mobileNavigation = document.querySelector("#mobile-navigation");

  const mobileLinks = document.querySelectorAll(
    ".mobile-navigation a"
  );

  const desktopLinks = document.querySelectorAll(
    ".desktop-navigation a"
  );

  // FIXED: Changed from .profile-social to correct class
  const socialLinks = document.querySelectorAll(
    ".social-orbit-button"
  );

  const pageContent = document.querySelector(".page-content");


  /* =======================================================
     02. PROFILE / DP OVERLAY
     ======================================================= */

  function openProfile() {
    body.classList.add("profile-open");
    body.classList.remove("menu-open");

    menuButton?.setAttribute("aria-expanded", "false");
    profileTrigger?.setAttribute("aria-expanded", "true");
    profilePanel?.setAttribute("aria-hidden", "false");

    // Trap focus in profile panel
    profilePanel?.focus();
  }

  function closeProfile() {
    body.classList.remove("profile-open");

    profileTrigger?.setAttribute("aria-expanded", "false");
    profilePanel?.setAttribute("aria-hidden", "true");

    // Restore focus to trigger
    profileTrigger?.focus();
  }

  function toggleProfile() {
    if (body.classList.contains("profile-open")) {
      closeProfile();
    } else {
      openProfile();
    }
  }


  /* =======================================================
     03. MENU
     ======================================================= */

  function openMenu() {
    body.classList.add("menu-open");
    body.classList.remove("profile-open");

    menuButton?.setAttribute("aria-expanded", "true");
    profileTrigger?.setAttribute("aria-expanded", "false");
    profilePanel?.setAttribute("aria-hidden", "true");
    mobileNavigation?.setAttribute("aria-hidden", "false");
  }

  function closeMenu() {
    body.classList.remove("menu-open");

    menuButton?.setAttribute("aria-expanded", "false");
    mobileNavigation?.setAttribute("aria-hidden", "true");

    // Restore focus to menu button
    menuButton?.focus();
  }

  function toggleMenu() {
    if (body.classList.contains("menu-open")) {
      closeMenu();
    } else {
      openMenu();
    }
  }


  /* =======================================================
     04. PREVENT OVERLAYS OPENING TOGETHER
     ======================================================= */

  function closeAllOverlays() {
    closeProfile();
    closeMenu();
  }


  /* =======================================================
     05. DP CLICK
     ======================================================= */

  profileTrigger?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    toggleProfile();
  });


  /* =======================================================
     06. MENU BUTTON CLICK
     ======================================================= */

  menuButton?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    toggleMenu();
  });


  /* =======================================================
     07. SOCIAL BUTTONS
     ======================================================= */

  socialLinks.forEach((social) => {
    social.addEventListener("click", (event) => {
      event.stopPropagation();
    });
  });


  /* =======================================================
     08. MOBILE NAVIGATION LINKS
     ======================================================= */

  mobileLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.stopPropagation();
      closeMenu();
    });
  });


  /* =======================================================
     09. DESKTOP NAVIGATION LINKS
     ======================================================= */

  desktopLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.stopPropagation();
      closeAllOverlays();
    });
  });


  /* =======================================================
     10. CLOSE PROFILE WHEN CLICKING OUTSIDE
     ======================================================= */

  profilePanel?.addEventListener("click", (event) => {
    // Only close if clicking the panel background, not children
    if (event.target === profilePanel) {
      closeProfile();
    }
  });


  /* =======================================================
     11. CLOSE MENU WHEN CLICKING OUTSIDE
     ======================================================= */

  mobileNavigation?.addEventListener("click", (event) => {
    // Allow clicks on nav links
    if (event.target.closest("a")) {
      return;
    }
    // Close if clicking canvas background
    if (event.target === mobileNavigation) {
      closeMenu();
    }
  });


  /* =======================================================
     12. ESCAPE KEY
     ======================================================= */

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") {
      return;
    }

    closeAllOverlays();
  });


  /* =======================================================
     13. ACTIVE SECTION NAVIGATION
     ======================================================= */

  const sections = document.querySelectorAll("main section[id]");

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          return;
        }

        const currentId = entry.target.getAttribute("id");

        // Remove active state from all links
        document
          .querySelectorAll(".desktop-navigation a")
          .forEach((link) => {
            link.classList.remove("active");
            link.removeAttribute("aria-current");
          });

        // Add active state to current section link
        const currentLink = document.querySelector(
          `.desktop-navigation a[href="#${currentId}"]`
        );

        if (currentLink) {
          currentLink.classList.add("active");
          currentLink.setAttribute("aria-current", "page");
        }
      });
    },
    {
      rootMargin: "-35% 0px -55% 0px",
      threshold: 0
    }
  );

  sections.forEach((section) => {
    sectionObserver.observe(section);
  });


  /* =======================================================
     14. SMOOTH INTERNAL NAVIGATION
     ======================================================= */

  document
    .querySelectorAll('a[href^="#"]')
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const targetId = link.getAttribute("href");

        if (
          !targetId ||
          targetId === "#" ||
          targetId.length < 2
        ) {
          return;
        }

        const target = document.querySelector(targetId);

        if (!target) {
          return;
        }

        event.preventDefault();

        closeAllOverlays();

        target.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });
    });


  /* =======================================================
     15. INITIAL STATE
     ======================================================= */

  closeAllOverlays();

});
